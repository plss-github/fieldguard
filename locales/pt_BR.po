#: front/config.form.php:37
msgid "Field Guard"
msgstr "Bloqueio de Campos"

#: front/config.form.php:81
msgid "Locked fields"
msgstr "Campos bloqueados"

#: front/config.form.php:89
msgid "No rule yet. Create the first one on the right."
msgstr "Nenhuma regra ainda. Crie a primeira ao lado."

#: front/config.form.php:104
msgid "Any profile"
msgstr "Qualquer perfil"

#: front/config.form.php:109
msgid "Any group"
msgstr "Qualquer grupo"

#: front/config.form.php:130
msgid "New rule"
msgstr "Nova regra"

#: front/config.form.php:136
msgid "e.g. Technicians without status"
msgstr "ex.: Técnicos sem status"

#: front/config.form.php:145
msgid "Leave profiles and groups empty to apply the rule to everyone. Filling both means the rule only applies to someone who holds one of the profiles AND belongs to one of the groups."
msgstr "Deixe perfis e grupos vazios para aplicar a regra a todos. Preenchendo os dois, a regra só vale para quem tem um dos perfis E pertence a um dos grupos."

#: front/rule.form.php:47
msgid "Rule saved"
msgstr "Regra salva"

#: front/rule.form.php:111
msgid "Loading form…"
msgstr "Carregando formulário…"

#: front/rule.form.php:112
msgid "locked field(s)"
msgstr "campo(s) bloqueado(s)"

#: front/rule.form.php:113
#, php-format
msgid "%d locked field(s) in this rule"
msgstr "%d campo(s) bloqueado(s) nesta regra"

#: front/rule.form.php:114
msgid "Saved"
msgstr "Salvo"

#: front/rule.form.php:115
msgid "Saving…"
msgstr "Salvando…"

#: front/rule.form.php:116
msgid "Could not save the change"
msgstr "Não foi possível salvar a alteração"

#: front/rule.form.php:117
msgid "Unsaved changes"
msgstr "Alterações não salvas"

#: front/rule.form.php:118
msgid "This rule has unsaved lock changes."
msgstr "Esta regra tem bloqueios não salvos."

#: front/rule.form.php:119
msgid "Remove every lock this rule holds on this form?"
msgstr "Remover todos os bloqueios que esta regra tem neste formulário?"

#: front/rule.form.php:120
msgid "This form has no field that can be locked."
msgstr "Este formulário não possui nenhum campo que possa ser bloqueado."

#: front/rule.form.php:121
#, php-format
msgid "This form only exists for a saved item. Enter an existing %s ID above."
msgstr "Este formulário só existe para um item salvo. Informe acima o ID de um registro de %s existente."

#: front/rule.form.php:122
msgid "Pick a form above to start locking fields."
msgstr "Escolha um formulário acima para começar a bloquear campos."

#: front/rule.form.php:123
#, php-format
msgid "Will be locked on %s"
msgstr "Será bloqueado em %s"

#: front/rule.form.php:124 front/rule.form.php:251
msgid "Use the tabs on the left of the preview to reach costs, items, contracts and anything else a form has."
msgstr "Use as abas à esquerda da pré-visualização para chegar a custos, itens, contratos e o que mais o formulário tiver."

#: front/rule.form.php:179
msgid "Empty: every profile."
msgstr "Vazio: todos os perfis."

#: front/rule.form.php:192
msgid "Empty: every group."
msgstr "Vazio: todos os grupos."

#: front/rule.form.php:215
msgid "Profiles and groups are combined with AND: a rule naming both only applies to someone who holds one of the profiles and belongs to one of the groups."
msgstr "Perfis e grupos são combinados com E: uma regra que informa os dois só vale para quem tem um dos perfis e pertence a um dos grupos."

#: front/rule.form.php:239
msgid "Item ID"
msgstr "ID do item"

#: front/rule.form.php:243
msgid "new item"
msgstr "novo item"

#: front/rule.form.php:245
msgid "Leave empty for the creation form. Fill it to reach fields that only exist on a saved item."
msgstr "Deixe em branco para o formulário de criação. Preencha para acessar campos que só existem em um item salvo."

#: front/rule.form.php:255
msgid "Lock mode"
msgstr "Modo de bloqueio"

#: front/rule.form.php:267
msgid "Reload preview"
msgstr "Recarregar pré-visualização"

#: front/rule.form.php:270
msgid "Clear locks on this form"
msgstr "Limpar bloqueios deste formulário"

#: front/rule.form.php:273
msgid "Save locks"
msgstr "Salvar bloqueios"

#: front/rule.form.php:283
msgid "Form preview"
msgstr "Pré-visualização do formulário"

#: inc/lock.class.php:30
msgid "Field guard"
msgstr "Bloqueio de campo"

#: inc/lock.class.php:36
msgid "Read-only (greyed out)"
msgstr "Somente leitura (esmaecido)"

#: inc/lock.class.php:37
msgid "Hidden"
msgstr "Oculto"

#: inc/lock.class.php:538 inc/rule.class.php:231 inc/rule.class.php:252
#, php-format
msgid "Table %s created"
msgstr "Tabela %s criada"

#: inc/lock.class.php:576
#, php-format
msgid "Profile %d"
msgstr "Perfil %d"

#: inc/lock.class.php:598
#, php-format
msgid "%d profile(s) converted into lock rules"
msgstr "%d perfil(is) convertido(s) em regras de bloqueio"

#: inc/rule.class.php:20
msgid "Lock rule"
msgid_plural "Lock rules"
msgstr[0] "Regra de bloqueio"
msgstr[1] "Regras de bloqueio"

#: inc/rule.class.php:41
msgid "Untitled rule"
msgstr "Regra sem título"

